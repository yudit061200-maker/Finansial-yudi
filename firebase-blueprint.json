{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "Bank and wallet accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "provider": { "type": "string" },
        "accountNumberMasked": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "accountHolder": { "type": "string" }
      },
      "required": ["id", "name", "type", "provider", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "accountId": { "type": "string" },
        "destinationAccountId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["id", "date", "title", "amount", "type", "category", "accountId"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Spending budgets per category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "monthlyLimit": { "type": "number" },
        "alertThreshold": { "type": "number" },
        "color": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "category", "monthlyLimit"]
    },
    "FinancialGoal": {
      "title": "FinancialGoal",
      "description": "Savings and financial goals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "monthlyContributionTarget": { "type": "number" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["id", "title", "targetAmount", "currentAmount"]
    },
    "DebtRecord": {
      "title": "DebtRecord",
      "description": "Debts and Receivables (Hutang dan Piutang)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "personName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "title": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "dueDate": { "type": "string" },
        "startDate": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "category": { "type": "string" },
        "payments": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "personName", "title", "totalAmount", "paidAmount", "remainingAmount", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "AI Chat History",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "sender", "text", "timestamp"]
    }
  }
}
