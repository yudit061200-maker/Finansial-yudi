{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "Bank and wallet accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "provider": { "type": "string" },
        "accountNumberMasked": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "accountHolder": { "type": "string" }
      },
      "required": ["id", "name", "type", "provider", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "accountId": { "type": "string" },
        "destinationAccountId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["id", "date", "title", "amount", "type", "category", "accountId"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Spending budgets per category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "monthlyLimit": { "type": "number" },
        "alertThreshold": { "type": "number" },
        "color": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "category", "monthlyLimit"]
    },
    "FinancialGoal": {
      "title": "FinancialGoal",
      "description": "Savings and financial goals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "monthlyContributionTarget": { "type": "number" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["id", "title", "targetAmount", "currentAmount"]
    },
    "DebtRecord": {
      "title": "DebtRecord",
      "description": "Debts and Receivables (Hutang dan Piutang)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "personName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "title": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "dueDate": { "type": "string" },
        "startDate": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "category": { "type": "string" },
        "payments": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "personName", "title", "totalAmount", "paidAmount", "remainingAmount", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "AI Chat History",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "sender", "text", "timestamp"]
    },
    "CompanySalaryProfile": {
      "title": "CompanySalaryProfile",
      "description": "Company profile with salary components, daily rates, and cut-off configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "jobTitle": { "type": "string" },
        "badgeColor": { "type": "string" },
        "employmentType": { "type": "string" },
        "baseSalary": { "type": "number" },
        "dailyRate": { "type": "number" },
        "standardWorkingDays": { "type": "number" },
        "isProratedBaseSalary": { "type": "boolean" },
        "isDailyTransport": { "type": "boolean" },
        "dailyTransportRate": { "type": "number" },
        "fixedAllowance": { "type": "number" },
        "transportAllowance": { "type": "number" },
        "otherAllowance": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "overtimeRatePerHour": { "type": "number" },
        "bonusOrThr": { "type": "number" },
        "includeBpjsKesehatan": { "type": "boolean" },
        "includeBpjsKetenagakerjaan": { "type": "boolean" },
        "calculatePph21": { "type": "boolean" },
        "taxMethod": { "type": "string" },
        "ptkpStatus": { "type": "string" },
        "hasNpwp": { "type": "boolean" },
        "loanOrCashAdvance": { "type": "number" },
        "absenceDeduction": { "type": "number" },
        "cooperativeFee": { "type": "number" },
        "otherDeduction": { "type": "number" },
        "cutOffConfig": { "type": "object" },
        "notes": { "type": "string" }
      },
      "required": ["id", "companyName", "employmentType", "baseSalary", "dailyRate"]
    },
    "WorkScheduleDay": {
      "title": "WorkScheduleDay",
      "description": "Daily calendar work attendance and overtime record",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "dayOfWeek": { "type": "number" },
        "dayNumber": { "type": "number" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "assignments": { "type": "object" },
        "isHoliday": { "type": "boolean" },
        "holidayName": { "type": "string" }
      },
      "required": ["date", "assignments"]
    },
    "SalarySettings": {
      "title": "SalarySettings",
      "description": "General settings for salary calculator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeName": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "employeeName"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Bank and digital wallet accounts"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Income, expense, and transfer records"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Monthly spending category budgets"
    },
    "/goals/{goalId}": {
      "schema": "FinancialGoal",
      "description": "Savings and financial goals"
    },
    "/debts/{debtId}": {
      "schema": "DebtRecord",
      "description": "Hutang and Piutang tracking"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Financial AI chat assistant messages"
    },
    "/salary_companies/{companyId}": {
      "schema": "CompanySalaryProfile",
      "description": "Company payroll profiles and salary configurations"
    },
    "/work_schedules/{date}": {
      "schema": "WorkScheduleDay",
      "description": "Calendar daily attendance and shift allocations"
    },
    "/salary_settings/{settingId}": {
      "schema": "SalarySettings",
      "description": "Global salary calculator settings"
    }
  }
}
